<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
		Push Notifications (`aps-environment`) requires a *paid* Apple
		Developer Program enrollment ($99/yr). The Personal team that
		ships this debug build doesn't have that entitlement, so Xcode
		refuses to sign:
		  Personal development teams … do not support the
		  Push Notifications capability.
		Removed for local dev. To re-enable when the team is upgraded:
		  <key>aps-environment</key>
		  <string>development</string>
	-->
</dict>
</plist>
