{
  "redirects": [
    {
      "source": "/:path((?!api/).*)",
      "has": [{ "type": "host", "value": "payn.online" }],
      "destination": "https://www.payn.online/:path",
      "permanent": true
    }
  ],
  "crons": [
    {
      "path": "/api/v1/offers/import",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/admin/push/dispatch-scheduled",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/v1/cron/check-alerts",
      "schedule": "0 7 * * *"
    }
  ]
}
