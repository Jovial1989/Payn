{
  "name": "payn",
  "private": true,
  "packageManager": "pnpm@10.7.1",
  "scripts": {
    "dev:web": "corepack pnpm --filter web dev",
    "build:web": "corepack pnpm --filter web build",
    "lint:web": "corepack pnpm --filter web lint",
    "typecheck:web": "corepack pnpm --filter web typecheck",
    "deploy:check": "corepack pnpm --filter web typecheck && corepack pnpm --filter web build",
    "reset-monetised": "bash scripts/reset-monetised.sh",
    "preview-email": "cd apps/web && npx tsx scripts/preview-emails.ts"
  }
}
